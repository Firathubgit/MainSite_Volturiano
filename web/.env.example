# Volturiano Builder Frontend Environment Variables
# Copy this file to .env and fill in the values for development
# VITE_ variables are embedded in the browser at build time. ONLY put public keys here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Builder Supabase (VolturianoBuilder — separate project)
VITE_BUILDER_SUPABASE_URL=
VITE_BUILDER_SUPABASE_ANON_KEY=

# Feature flags (safe defaults)
VITE_ENABLE_R3F_MODE=false
VITE_ENABLE_WORLD=false
VITE_ENABLE_INVEST=false
VITE_ENABLE_AI_HELPER=false
