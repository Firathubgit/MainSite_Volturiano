# Server Config
PORT=3001
CORS_ORIGIN=https://volturiano.com

# Sandbox Provider
SANDBOX_PROVIDER=e2b
E2B_API_KEY=

# AI Providers (At least one is required)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MORPH_API_KEY=

# Supabase (VolturianoBuilder Project — Keep Service Role Key Secret!)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Stripe Billing ───
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Product Price IDs from Stripe Dashboard
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_AGENCY=

# Frontend URL for Stripe redirects & callbacks
FRONTEND_URL=https://volturiano.com

# ─── GitHub Publishing OAuth ───
# Two OAuth Apps on github.com → Settings → Developer settings → OAuth Apps:
#   - prod: callback https://volturiano.com/api/integrations/github/callback
#   - local: callback http://localhost:3001/api/integrations/github/callback
# Active block (LOCAL or PROD) is uncommented; the other stays commented out.
GITHUB_PUBLISH_CLIENT_ID=
GITHUB_PUBLISH_CLIENT_SECRET=
GITHUB_PUBLISH_REDIRECT_URI=
GITHUB_PUBLISH_FRONTEND_RETURN_URL=

# AES-256-GCM key (64 hex chars / 32 bytes) for encrypting persisted GitHub
# access tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=
