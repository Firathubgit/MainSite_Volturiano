  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev:server\"",
    "dev:server": "cd server && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:server": "vitest run tests/server",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:server && npm run test:agent-harness && npm run test:core-access && npm run test:audit-retention && npm run test:stripe-billing && npm run test:community-moderation && npm run test:admin-review-queue && npm run test:gdpr-settings && npm run test:backup-ops && npm run test:launch-testnet",
