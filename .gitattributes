* text=auto

# Normalize line endings for source files
*.js   eol=lf
*.jsx  eol=lf
*.css  eol=lf
*.json eol=lf
*.md   eol=lf
*.yml  eol=lf
*.yaml eol=lf
*.sh   eol=lf
*.ts   eol=lf

# Windows scripts
*.bat  eol=crlf

# Treat binary assets correctly
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.hdr  binary
*.mp4  binary
*.glb  binary
*.gltf binary

