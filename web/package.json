    "clsx": "^2.1.1",
    "cobe": "^0.6.3",
    "color-bits": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "hls.js": "^1.6.15",
    "i18next": "^23.10.0",
