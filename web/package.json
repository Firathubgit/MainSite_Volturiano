    "test:core-access": "node server/scripts/core-access-regression.js",
    "test:audit-retention": "node server/scripts/audit-retention-regression.js",
    "test:stripe-billing": "node server/scripts/stripe-billing-regression.js",
    "test:community-moderation": "node server/scripts/community-moderation-regression.js",
    "test:admin-review-queue": "node server/scripts/admin-review-queue-regression.js",
    "test:gdpr-settings": "node server/scripts/gdpr-settings-regression.js",
    "test:backup-ops": "node server/scripts/backup-ops-regression.js",
    "test:launch-testnet": "node server/scripts/launch-testnet-regression.js",
    "test:staging-smoke": "node server/scripts/staging-launch-smoke.js --plan"
  },
