# Copy this file to .env and fill in the two required parts:
# one model provider key and the E2B key.

# --- Required: at least one model provider ---------------------------------
# Google Gemini key (the default model is Gemini).
GEMINI_API_KEY=
# OpenAI key.
OPENAI_API_KEY=
# Anthropic key.
ANTHROPIC_API_KEY=

# --- Required: sandbox ------------------------------------------------------
# E2B key. Every generated site is built and previewed inside an E2B sandbox.
E2B_API_KEY=

# --- Optional: server -------------------------------------------------------
# Port for the API server.
PORT=
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=
# Model and sandbox requests allowed per minute. 0 turns rate limiting off.
RATE_LIMIT_PER_MINUTE=
# Folder for projects, snapshots and agent history.
DATA_DIR=
# Folder with registry components and templates.
REGISTRY_DIR=
# Custom base URL for an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
# Set to true when Chromium must run without its sandbox (some containers).
CHROMIUM_NO_SANDBOX=

# --- Optional: publish to GitHub -------------------------------------------
# Client id of a GitHub OAuth app with callback /api/integrations/github/callback.
GITHUB_PUBLISH_CLIENT_ID=
# Client secret of that OAuth app.
GITHUB_PUBLISH_CLIENT_SECRET=
# 64 hex characters used to encrypt the stored GitHub token.
GITHUB_TOKEN_ENCRYPTION_KEY=
# OAuth callback URL, if the server is not on localhost.
GITHUB_PUBLISH_REDIRECT_URI=
# Where the browser returns after connecting GitHub.
GITHUB_PUBLISH_FRONTEND_RETURN_URL=
